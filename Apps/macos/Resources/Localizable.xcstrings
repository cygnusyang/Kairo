{
  "sourceLanguage": "en",
  "strings": {
    "alert.load.group_promoted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task “%1$@” has subtasks and was treated as a group"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务「%1$@」有子项，已按群组处理"
          }
        }
      }
    },
    "alert.notice.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@; %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@；%2$@"
          }
        }
      }
    },
    "date.field.disabled.aggregate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group fields are aggregated from subtasks and read-only"
          }
