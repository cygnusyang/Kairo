    "update.error.app_not_found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No .app found in the update package; installation refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新包内未找到 .app，已拒绝安装。"
          }
        }
      }
    },
    "update.error.build_time_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update manifest build time is invalid: %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新清单构建时间无效：%1$@。"
          }
        }
      }
    },
    "update.error.cdhash_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app CDHash does not match the update manifest; installation refused (possibly an unofficial build)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用 CDHash 与更新清单不符，已拒绝安装（可能非官方构建）。"
          }
        }
      }
    },
    "update.error.cdhash_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app signing information has no CDHash; installation refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用签名信息缺少 CDHash，已拒绝安装。"
          }
        }
      }
    },
    "update.error.check_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update check failed (%1$@); try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新失败（%1$@），请稍后重试。"
          }
        }
      }
    },
    "update.error.checksum_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download integrity check failed (SHA256 mismatch); installation refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载包完整性校验失败（SHA256 不匹配），已拒绝安装。"
          }
        }
      }
    },
    "update.error.checksum_read_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download integrity check failed: cannot read the downloaded file (%1$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载包完整性校验失败：无法读取下载文件（%1$@）。"
          }
        }
      }
    },
    "update.error.code_create_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read the signing information of the app to install (OSStatus %1$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取待安装应用的签名信息（OSStatus %1$@）。"
          }
        }
      }
    },
    "update.error.download_save_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to save the downloaded package: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载产物保存失败：%1$@"
          }
        }
      }
    },
    "update.error.download_url_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update manifest download URL is invalid: %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新清单下载地址无效：%1$@。"
          }
        }
      }
    },
    "update.error.endpoint_host": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update endpoint %1$@ is not allowlisted; connection refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新端点 %1$@ 不在白名单内，已拒绝连接。"
          }
        }
      }
    },
    "update.error.endpoint_scheme": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update requests must use HTTPS (current scheme is %1$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新请求必须使用 HTTPS（当前 scheme 为 %1$@）。"
          }
        }
      }
    },
    "update.error.http_status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server returned HTTP %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务器返回 HTTP %1$@。"
          }
        }
      }
    },
    "update.error.identifier_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App identifier “%1$@” does not match the expected value; installation refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用标识符「%1$@」与预期不符，已拒绝安装。"
          }
        }
      }
    },
    "update.error.install_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous update failed (exit code %1$@): %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次更新失败（退出码 %1$@）：%2$@"
          }
        }
      }
    },
    "update.error.install_result_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous update result could not be read and was ignored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次更新结果无法读取，已忽略。"
          }
        }
      }
    },
    "update.error.launch_path_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The running app is not the copy installed in Applications; run the update from Applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前运行的应用不是已安装版本（应用程序文件夹），请从「应用程序」中执行更新。"
          }
        }
      }
    },
    "update.error.manifest_app_id_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update manifest appId “%1$@” does not match this app; installation refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新清单 appId「%1$@」与本应用不匹配，已拒绝安装。"
          }
        }
      }
    },
    "update.error.manifest_invalid_json": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update manifest is malformed: %1$@"
