    "update.error.minimum_version_unmet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current version %1$@ is below the minimum supported version %2$@; download the new version manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本 %1$@ 低于最低支持版本 %2$@，请手动下载新版本。"
          }
