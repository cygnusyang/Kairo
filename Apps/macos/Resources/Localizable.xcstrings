    "violation.constraint_conflict.latest_end_before_constraint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "latest end is before the constraint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最晚结束早于时限"
          }
        }
      }
    },
    "violation.constraint_conflict.latest_start_before_constraint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "latest start is before the constraint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最晚开始早于时限"
          }
        }
      }
    },
    "violation.constraint_conflict.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task “%1$@”: its “%2$@” constraint conflicts with the dependency chain: %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务「%1$@」的「%2$@」时限与相关性链冲突：%3$@"
          }
        }
      }
    },
    "violation.constraint_conflict.window_does_not_fit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the window cannot hold the task duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口无法容纳任务持续时间"
          }
        }
      }
    },
    "violation.constraint_unmet_by_prerequisite.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task “%1$@” cannot meet its “%2$@” constraint because of prerequisites"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务「%1$@」因先决条件无法满足「%2$@」时限"
          }
        }
      }
    },
    "violation.constraint_window_too_narrow.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task “%1$@”: its start and end constraints are only %2$ld days apart and cannot hold the %3$ld-day duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务「%1$@」的开始时限与结束时限相距过近（%2$ld 天），无法容纳持续时间（%3$ld 天）"
          }
        }
      }
    },
    "violation.cycle.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task “%1$@” is part of a dependency cycle, so its order cannot be determined"
