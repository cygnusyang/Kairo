          }
        }
      }
    },
    "update.error.unzip_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to unzip the update package: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新包解压失败：%1$@"
          }
        }
      }
    },
    "update.error.version_unparsable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot compare versions: manifest %1$@, current %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法比较版本号：清单 %1$@，当前 %2$@。"
